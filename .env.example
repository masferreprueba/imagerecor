# Frontend (valor visible en el navegador)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Proveedor inicial importado desde variables: claid | photoroom | removebg | poof
IMAGE_API_PROVIDER=claid
IMAGE_API_KEY=pega-aqui-tu-llave
IMAGE_API_KEYS=pega-aqui-otras-llaves-separadas-por-coma
API_KEY_ENCRYPTION_SECRET=genera-un-secreto-largo-y-aleatorio
IMAGE_API_TIMEOUT=90
IMAGE_API_MAX_RETRIES=3
LOCAL_BACKGROUND_REMOVAL_ENABLED=true
LOCAL_BACKGROUND_REMOVAL_MODEL=u2netp
LOCAL_BACKGROUND_REMOVAL_MAX_SIDE=1024

# Procesamiento
OUTPUT_SIZE=500
OBJECT_MARGIN_PERCENT=10
PROCESSING_CONCURRENCY=4
MAX_UPLOAD_MB=250
MAX_FILES_PER_ZIP=2000
MAX_UNCOMPRESSED_MB=1500
MAX_COMPRESSION_RATIO=100
TEMP_TTL_HOURS=24

# Cola y base de datos para Docker Compose
TASK_QUEUE=celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
DATABASE_URL=postgresql+psycopg://image_processor:change-me-in-production@postgres:5432/image_processor
STORAGE_ROOT=/app/data/jobs

# Dominios permitidos, separados por coma
CORS_ORIGINS=http://localhost:3000
